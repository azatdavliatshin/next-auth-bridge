# Better Auth reference tenant app — environment contract.
#
# These are PLACEHOLDERS only. Copy to .env.local for local development and set
# the real values in your Vercel project settings / CI secrets. Never commit real
# secrets. This file is the source of truth for the Vercel project config (Plan 04).
#
# This is the Better Auth analog of examples/tenant-app/.env.example. The infra is
# deliberately the SAME shape (one shared bridge transferStore in KV, the same
# Keycloak realm/client); only the auth library differs. The differences from the
# Auth.js set are called out inline below.

# --- Better Auth core ---------------------------------------------------------
# Better Auth uses BETTER_AUTH_SECRET / BETTER_AUTH_URL — NOT Auth.js's AUTH_SECRET
# / AUTH_URL. Session-encryption secret; generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-long-random-string
# This app's own canonical origin. Better Auth derives its callback base URL from
# it, so it MUST match the deployed tenant origin (the nab-ba-tenant project).
BETTER_AUTH_URL=https://nab-ba-tenant.vercel.app

# --- Better Auth session database (D-03) --------------------------------------
# Better Auth's OWN session/user DB (orthogonal to the bridge KV transferStore).
# DB env-flip on TURSO_DATABASE_URL presence (see lib/db.ts):
#   set    -> hosted libSQL/Turso (the deploy; Vercel's filesystem is ephemeral)
#   unset  -> local better-sqlite3 file at BA_SQLITE_PATH (pnpm dev / tests)
# Turso libSQL connection URL (e.g. libsql://your-db.turso.io).
TURSO_DATABASE_URL=libsql://your-db.turso.io
# Turso auth token for the database above.
TURSO_AUTH_TOKEN=your-turso-auth-token
# Local file-SQLite path used only when TURSO_DATABASE_URL is unset. Default ba.sqlite.
BA_SQLITE_PATH=ba.sqlite

# --- Seed (D-04: one script, two targets, same credentials) -------------------
# The deterministic LIVE-URL test user, created via auth.api.signUpEmail (scripts/seed.ts).
# SAME credentials seed both the local file SQLite and the Turso target.
SEED_EMAIL=bridge-test-user@example.test
SEED_PASSWORD=replace-with-the-seed-password

# --- Shared Keycloak (cold-start parity, D-06) --------------------------------
# SAME bridge-agnosticism realm / bridge-example-app client / realm-scoped secret
# as the Auth.js set — the BA genericOAuth social provider points at this realm so
# the cold-start prompt=none silent re-auth reuses the same SSO session. The BA
# callback path is /api/auth/oauth2/callback/{providerId} (keycloak + keycloak-silent),
# NOT Auth.js's /api/auth/callback/keycloak.
# Confidential client; the secret lives in deployment env ONLY, never in git.
AUTH_KEYCLOAK_ID=bridge-example-app
AUTH_KEYCLOAK_SECRET=set-in-deployment-only
AUTH_KEYCLOAK_ISSUER=https://<your-keycloak>/realms/bridge-agnosticism

# --- Bridge transfer store (KV) — the BA set's OWN namespace (D-02) ------------
# The one-time-code transferStore shared by both bridge transports. The BA deploy
# MUST use its OWN Upstash namespace/instance, distinct from the Auth.js deploy's,
# so the two deploys' one-time codes never collide.
KV_REST_API_URL=https://your-ba-upstash-endpoint.upstash.io
KV_REST_API_TOKEN=your-ba-upstash-rest-token

# --- Origins (the nab-ba-* split) ---------------------------------------------
# This app's own origin (the embedded tenant). Used as a bridge allowlist entry and
# the popup postMessage receiver pin.
APP_ORIGIN=https://nab-ba-tenant.vercel.app
# The separate host-shell origin that cross-site-iframes this app. Distinct from
# APP_ORIGIN — the two must be different sites for the CHIPS handoff to be real.
HOST_SHELL_ORIGIN=https://nab-ba-host.vercel.app
# Browser-exposed copy of the app origin for the popup page (NEXT_PUBLIC_*).
NEXT_PUBLIC_APP_ORIGIN=https://nab-ba-tenant.vercel.app
