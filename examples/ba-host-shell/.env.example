# Better Auth host-shell app — environment contract.
#
# This is the SEPARATE site that embeds the BA tenant app as a cross-site iframe.
# It is a distinct deploy target (the nab-ba-host project, its own *.vercel.app
# origin), which is what makes the embedded tenant app genuinely third-party and
# the CHIPS partitioned-cookie handoff real rather than a hollow first-party
# shortcut.
#
# The host-shell is ALSO authenticated, standing in for an enterprise host that is
# itself signed into the identity provider. It uses the SAME Keycloak realm/client
# as the tenant app, with BOTH origins registered, so the IdP SSO session is shared.
# That shared session is what lets the tenant app's bridge popup mint its session
# via a silent prompt=none re-auth with no second login.
#
# This is the Better Auth analog of examples/host-shell/.env.example — same shape,
# only the auth library differs. PLACEHOLDERS only; never commit real values.

# --- Origins (the nab-ba-* split) ---------------------------------------------
# The tenant app's origin — the site this host embeds in its iframe. Must be a
# DIFFERENT site from this host-shell's own origin.
APP_ORIGIN=https://nab-ba-tenant.vercel.app
# Browser-exposed copy of the tenant app origin for the client-rendered iframe.
NEXT_PUBLIC_APP_ORIGIN=https://nab-ba-tenant.vercel.app
# This host-shell's own canonical origin (the nab-ba-host deploy).
HOST_SHELL_ORIGIN=https://nab-ba-host.vercel.app

# --- Better Auth core ---------------------------------------------------------
# Better Auth uses BETTER_AUTH_SECRET / BETTER_AUTH_URL — NOT Auth.js's AUTH_SECRET
# / AUTH_URL. Session-encryption secret; generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-long-random-string
# This host's own canonical origin (the nab-ba-host project). Better Auth derives
# its callback base URL from it.
BETTER_AUTH_URL=https://nab-ba-host.vercel.app

# --- Shared Keycloak (D-06) ---------------------------------------------------
# SAME bridge-agnosticism realm / bridge-example-app client / realm-scoped secret
# as the tenant app — both apps point at the SAME realm/client so the host sign-in
# establishes the SSO session the embedded app's popup silently reuses. Register
# BOTH origins' BA oauth2/callback URIs on the client (see realm-export.json):
#   https://nab-ba-host.vercel.app/api/auth/oauth2/callback/keycloak
#   https://nab-ba-tenant.vercel.app/api/auth/oauth2/callback/keycloak
# Confidential client; the secret lives in deployment env ONLY, never in git.
AUTH_KEYCLOAK_ID=bridge-example-app
AUTH_KEYCLOAK_SECRET=set-in-deployment-only
AUTH_KEYCLOAK_ISSUER=https://<your-keycloak>/realms/bridge-agnosticism
