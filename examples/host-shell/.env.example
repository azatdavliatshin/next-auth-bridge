# Host-shell app — environment contract.
#
# This is the SEPARATE site that embeds the tenant app as a cross-site iframe. It
# is a distinct deploy target (its own *.vercel.app origin), which is what makes
# the embedded tenant app genuinely third-party and the CHIPS partitioned-cookie
# handoff real rather than a hollow first-party shortcut.
#
# The host-shell is ALSO authenticated against Microsoft Entra — it stands in for
# an enterprise host that is itself signed into the identity provider. It uses the
# SAME Entra app registration (same client id) as the tenant app, with BOTH
# origins' redirect URIs registered on that registration, so the IdP SSO session
# and consent are shared. That shared session is what lets the tenant app's bridge
# popup mint its session via a silent `prompt=none` auth with no second login.
#
# PLACEHOLDERS only. Copy to .env.local for local development and set the real
# values in your Vercel project settings. Never commit real values.

# The tenant app's origin — the site this host embeds in its iframe. Must be a
# DIFFERENT site from this host-shell's own origin.
APP_ORIGIN=https://your-app.vercel.app
# Browser-exposed copy of the tenant app origin for the client-rendered iframe.
NEXT_PUBLIC_APP_ORIGIN=https://your-app.vercel.app

# Auth.js session encryption secret. Generate one with: npx auth secret
AUTH_SECRET=replace-with-a-long-random-string

# Microsoft Entra app registration — the SAME registration the tenant app uses.
# Register BOTH origins' callback URIs on it:
#   https://your-host-shell.vercel.app/api/auth/callback/microsoft-entra-id
#   https://your-app.vercel.app/api/auth/callback/microsoft-entra-id
# Application (client) ID.
AUTH_MICROSOFT_ENTRA_ID_ID=your-entra-application-client-id
# A client secret value.
AUTH_MICROSOFT_ENTRA_ID_SECRET=your-entra-client-secret
# Entra authority. /common = multi-tenant + personal accounts (the default).
AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/common/v2.0
