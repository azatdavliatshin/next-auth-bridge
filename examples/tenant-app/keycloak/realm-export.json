{
  "realm": "bridge-agnosticism",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "bruteForceProtected": false,
  "clients": [
    {
      "clientId": "bridge-test-client",
      "name": "Bridge agnosticism test client",
      "description": "Public client used by the browserless auth-code + PKCE (S256) CI login. Standard flow only; Direct Access Grants (ROPC) is disabled so the only viable login is the real PKCE auth-code dance.",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "redirectUris": [
        "http://localhost:3000/auth/callback/keycloak",
        "http://127.0.0.1:3000/auth/callback/keycloak"
      ],
      "webOrigins": [
        "http://localhost:3000",
        "http://127.0.0.1:3000"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      },
      "defaultClientScopes": [
        "profile",
        "email"
      ]
    },
    {
      "clientId": "bridge-example-app",
      "name": "Bridge example app",
      "description": "Confidential popup-bridge demo client shared by ALL four example apps (Auth.js host-shell + tenant-app on nab-host/nab-tenant, and the Better Auth ba-host-shell + ba-tenant-app on nab-ba-host/nab-ba-tenant) so one Keycloak SSO session spans both sets. Auth-code + PKCE (S256), ROPC off. Auth.js callback path is /api/auth/callback/keycloak; Better Auth genericOAuth callback path is /api/auth/oauth2/callback/{providerId} (keycloak interactive + keycloak-silent prompt=none). Secret set in deployment env only. See examples/keycloak-demo/DEPLOY.md.",
      "enabled": true,
      "publicClient": false,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "consentRequired": false,
      "protocol": "openid-connect",
      "redirectUris": [
        "https://nab-tenant.vercel.app/api/auth/callback/keycloak",
        "https://nab-host.vercel.app/api/auth/callback/keycloak",
        "http://localhost:3000/api/auth/callback/keycloak",
        "http://localhost:3001/api/auth/callback/keycloak",
        "http://127.0.0.1:3000/api/auth/callback/keycloak",
        "http://127.0.0.1:3001/api/auth/callback/keycloak",
        "https://nab-ba-tenant.vercel.app/api/auth/oauth2/callback/keycloak",
        "https://nab-ba-tenant.vercel.app/api/auth/oauth2/callback/keycloak-silent",
        "https://nab-ba-host.vercel.app/api/auth/oauth2/callback/keycloak",
        "https://nab-ba-host.vercel.app/api/auth/oauth2/callback/keycloak-silent",
        "http://localhost:3002/api/auth/oauth2/callback/keycloak",
        "http://localhost:3002/api/auth/oauth2/callback/keycloak-silent",
        "http://localhost:3003/api/auth/oauth2/callback/keycloak",
        "http://localhost:3003/api/auth/oauth2/callback/keycloak-silent",
        "http://127.0.0.1:3002/api/auth/oauth2/callback/keycloak",
        "http://127.0.0.1:3002/api/auth/oauth2/callback/keycloak-silent",
        "http://127.0.0.1:3003/api/auth/oauth2/callback/keycloak",
        "http://127.0.0.1:3003/api/auth/oauth2/callback/keycloak-silent"
      ],
      "webOrigins": [
        "https://nab-tenant.vercel.app",
        "https://nab-host.vercel.app",
        "http://localhost:3000",
        "http://localhost:3001",
        "http://127.0.0.1:3000",
        "http://127.0.0.1:3001",
        "https://nab-ba-tenant.vercel.app",
        "https://nab-ba-host.vercel.app",
        "http://localhost:3002",
        "http://localhost:3003",
        "http://127.0.0.1:3002",
        "http://127.0.0.1:3003"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      },
      "defaultClientScopes": [
        "profile",
        "email"
      ]
    }
  ],
  "users": [
    {
      "username": "bridge-test-user",
      "email": "bridge-test-user@example.test",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Bridge",
      "lastName": "Tester",
      "credentials": [
        {
          "type": "password",
          "value": "bridge-test-password",
          "temporary": false
        }
      ]
    }
  ]
}
