# Reference tenant app — environment contract.
#
# These are PLACEHOLDERS only. Copy to .env.local for local development and set
# the real values in your Vercel project settings / CI secrets. Never commit real
# secrets.

# Auth.js session encryption secret. Generate one with: npx auth secret
AUTH_SECRET=replace-with-a-long-random-string

# Which Auth.js provider this example is wired to. Unset or "entra" keeps the
# default Microsoft Entra path; "keycloak" selects the self-hosted public-demo
# Keycloak. NEXT_PUBLIC_ so client signIn callsites and server auth.ts agree.
NEXT_PUBLIC_AUTH_PROVIDER=keycloak            # entra (default) | keycloak

# Keycloak demo provider (only used when NEXT_PUBLIC_AUTH_PROVIDER=keycloak).
# Confidential client; the secret lives in deployment env ONLY, never in git.
AUTH_KEYCLOAK_ID=bridge-example-app
AUTH_KEYCLOAK_SECRET=set-in-deployment-only
AUTH_KEYCLOAK_ISSUER=https://<your-keycloak>/realms/bridge-agnosticism
# Single fixed tenant every Keycloak demo user resolves to (Keycloak has no Entra
# tid claim). Must equal a configured /t/[tenant] slug so the membership check passes.
DEMO_TENANT_ID=demo                           # tenant-app only

# Microsoft Entra app registration — Application (client) ID.
AUTH_MICROSOFT_ENTRA_ID_ID=your-entra-application-client-id
# Microsoft Entra app registration — a client secret value.
AUTH_MICROSOFT_ENTRA_ID_SECRET=your-entra-client-secret
# Entra authority. /common = multi-tenant + personal accounts (the default).
AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/common/v2.0

# Upstash Redis REST endpoint backing the one-time transfer store.
KV_REST_API_URL=https://your-upstash-endpoint.upstash.io
# Upstash Redis REST token.
KV_REST_API_TOKEN=your-upstash-rest-token
# Redis.fromEnv() also accepts the UPSTASH_REDIS_REST_URL / _TOKEN names below as
# equivalents — set either pair, not both.
# UPSTASH_REDIS_REST_URL=https://your-upstash-endpoint.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# This app's own origin (the iframe / embedded app). Used as a bridge allowlist
# entry and as the popup postMessage receiver pin.
APP_ORIGIN=https://your-app.vercel.app
# The separate host-shell origin that cross-site-iframes this app. Distinct from
# APP_ORIGIN — the two must be different sites for the CHIPS handoff to be real.
HOST_SHELL_ORIGIN=https://your-host-shell.vercel.app
# Browser-exposed copy of the app origin for the popup page (NEXT_PUBLIC_*).
NEXT_PUBLIC_APP_ORIGIN=https://your-app.vercel.app
